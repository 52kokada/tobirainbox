[Unit]
Description=TobirAInbox mailbox worker (check + sort, shadow-safe)
After=network.target

[Service]
Type=simple
User=tobira-inbox
Group=tobira-inbox
WorkingDirectory=/opt/tobira-inbox
EnvironmentFile=/opt/tobira-inbox/.env
ExecStart=/usr/bin/node apps/server/worker.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tobira-inbox-worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/tobira-inbox/data
MemoryMax=400M

[Install]
WantedBy=multi-user.target
